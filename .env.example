# Get a free key at https://api.watchmode.com/requestApiKey/
# Leave empty to run in demo mode with generated sample data.
WATCHMODE_API_KEY=

# Default country for "where to watch" results (two-letter code).
# The free Developer plan only enables a few countries.
WATCHMODE_REGION=US

# Port for the API server (the Vite dev server proxies /api to it).
PORT=8787

# Multiply every cache lifetime by this number. Raise it to save credits.
CACHE_TTL_SCALE=1

# Force demo data even when an API key is set (true/false).
WATCHMODE_DEMO=false
